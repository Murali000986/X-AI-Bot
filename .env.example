# ==========================================
# X AI Multi-Agent Chatbot Settings
# ==========================================

# 1. Server & Admin UI
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=super_secret_jwt_key_must_be_at_least_32_chars_long

# Default login credentials for the web dashboard -> /login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=strongpassword123

# 2. X (Twitter) API Config
# Obtain from developer.x.com
X_BOT_USERNAME=YourBotHandle
X_BEARER_TOKEN=your_v2_bearer_token
X_CLIENT_ID=your_oauth2_client_id
X_CLIENT_SECRET=your_oauth2_client_secret
X_ACCESS_TOKEN=your_oauth1a_access_token
X_ACCESS_SECRET=your_oauth1a_access_secret
X_WEBHOOK_SECRET=your_webhook_crc_secret

# 3. LLM Providers (Configure at least one)
GEMINI_API_KEY=your_gemini_key
OPENAI_API_KEY=your_openai_key
GROQ_API_KEY=your_groq_key

# 4. Database connections
MONGODB_URI=mongodb://localhost:27017/x-chatbot
REDIS_URL=redis://localhost:6379
